#!/bin/bash
# =============================================================================
# train_mlp.sbatch -- Module 1 / Lab 1 -- train mlp_constitutive.py on ARCC
# =============================================================================
#
# Train the constitutive MLP on the dataset previously generated by
# generate_data.py. This is the canonical "PyTorch training on ARCC" SLURM
# pattern that every subsequent module's labs will adapt.
#
# Prereqs:
#   - data/single_element.csv exists (generated on a login node via
#     generate_data.py, or pre-generated on a laptop and copied to ARCC).
#   - The 'ml4sm' conda env at /project/me5475/envs/ml4sm provides PyTorch.
#
# ARCC setup confirmed 2026-06-06 (Phase 0 recon): account=me5475, partition=mb (CPU).
# ML env: /project/me5475/envs/ml4sm (conda, created 2026-05-19).
# No pytorch module on mb cluster — conda env is the only path.
# =============================================================================

#SBATCH --job-name=mlp_constitutive
#SBATCH --account=me5475
#SBATCH --partition=mb
#SBATCH --time=00:30:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --output=mlp-%j.out
#SBATCH --error=mlp-%j.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=xiang.zhang@uwyo.edu

set -euo pipefail

# -----------------------------------------------------------------------------
# Activate shared ML conda environment.
# -----------------------------------------------------------------------------
module purge
module load miniconda3/24.3.0
source /apps/u/opt/linux/miniconda3/24.3.0/etc/profile.d/conda.sh
conda activate /project/me5475/envs/ml4sm

# -----------------------------------------------------------------------------
# Move into the submit directory (sbatch starts you there, but be explicit).
# -----------------------------------------------------------------------------
cd $SLURM_SUBMIT_DIR

echo "----- Job start: $(date) -----"
echo "Running on: $(hostname)"
echo "Python: $(which python)"
python --version
python -c "import torch; print(f'PyTorch: {torch.__version__}, CUDA available: {torch.cuda.is_available()}')"
echo

# -----------------------------------------------------------------------------
# Run the training.
# -----------------------------------------------------------------------------
srun python mlp_constitutive.py \
    --data data/single_element.csv \
    --epochs 5000 \
    --hidden 32 \
    --layers 4 \
    --out checkpoints/mlp_constitutive.pt

echo
echo "----- Job end: $(date) -----"
