#!/bin/bash
# =============================================================================
# train_mlp.sbatch -- Module 1 / Lab 1 -- train mlp_constitutive.py on ARCC
# =============================================================================
#
# Train the constitutive MLP on the dataset previously generated by
# generate_data.py. This is the canonical "PyTorch training on ARCC" SLURM
# pattern that every subsequent module's labs will adapt.
#
# Prereqs:
#   - data/single_element.csv exists (generated on a login node via
#     generate_data.py, or pre-generated on a laptop and copied to ARCC).
#   - The 'ml4sm' conda env at /project/me5475/envs/ml4sm provides PyTorch.
#
# ARCC setup confirmed 2026-06-06 (Phase 0 recon): account=me5475, partition=mb (CPU).
# ML env: /project/me5475/envs/ml4sm (conda, created 2026-05-19).
# No pytorch module on mb cluster — conda env is the only path.
# =============================================================================

#SBATCH --job-name=mlp_constitutive
#SBATCH --account=me5475
#SBATCH --partition=mb
#SBATCH --time=00:30:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --output=mlp-%j.out
#SBATCH --error=mlp-%j.err
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=<your-email>

set -euo pipefail

# -----------------------------------------------------------------------------
# Activate shared ML conda environment.
# -----------------------------------------------------------------------------
module purge
module load miniconda3/24.3.0
source /apps/u/opt/linux/miniconda3/24.3.0/etc/profile.d/conda.sh
conda activate /project/me5475/envs/ml4sm

# -----------------------------------------------------------------------------
# Keep the math libraries inside the cores SLURM actually gave us. Left unset,
# torch sees all 96 cores on the node and spawns that many threads inside a
# 4-core cgroup -- the threads then fight for the same four cores. This is the
# 6:45-vs-22s slowdown measured in the 2026-08-18 ARCC smoke test.
# -----------------------------------------------------------------------------
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-1}
export MKL_NUM_THREADS=${SLURM_CPUS_PER_TASK:-1}

# -----------------------------------------------------------------------------
# Move into the submit directory (sbatch starts you there, but be explicit).
# -----------------------------------------------------------------------------
cd "$SLURM_SUBMIT_DIR"

echo "----- Job start: $(date) -----"
echo "Running on: $(hostname)"
echo "Python: $(which python)"
python --version
python -c "import torch; print(f'PyTorch: {torch.__version__}, CUDA available: {torch.cuda.is_available()}')"
echo

# -----------------------------------------------------------------------------
# Run the training.
# -----------------------------------------------------------------------------

# NOTE (2026-09-18, verified on MedicineBow): call the interpreter by its full
# path, not bare `python`. If you `source setup5475.sh` and THEN `sbatch`, the
# job inherits CONDA_PREFIX from your shell, `module purge` strips conda off
# PATH, and the `conda activate` below then no-ops because conda believes the
# env is already active -- so bare `python` resolves to the base interpreter and
# the job dies with ModuleNotFoundError. Reproduced as jobs 17587307 (clean
# shell, PASS) vs 17587308 (after sourcing, FAIL); this form passes from both.
srun "$CONDA_PREFIX/bin/python" mlp_constitutive.py \
    --data data/single_element.csv \
    --epochs 5000 \
    --hidden 32 \
    --layers 4 \
    --out checkpoints/mlp_constitutive.pt

echo
echo "----- Job end: $(date) -----"
